# Template only: the application does not automatically load .env files.
# Set these variables in the deployment platform's environment configuration.
# Configure OIDC client credentials in .streamlit/secrets.toml or the host's
# secret manager. APP_ALLOWED_EMAILS is a comma-separated exact email allowlist.
APP_ALLOWED_EMAILS=
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501

# For container hosting only, configure STREAMLIT_SERVER_ADDRESS=0.0.0.0
# through the platform environment and keep the service behind its ingress/auth layer.
