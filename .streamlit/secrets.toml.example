# Copy into the host's secret manager or a local ignored secrets.toml.
# Replace every placeholder. Never commit real client or cookie secrets.
[auth]
redirect_uri = "https://your-host.invalid/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
client_id = "REPLACE_WITH_IDENTITY_PROVIDER_CLIENT_ID"
client_secret = "REPLACE_WITH_IDENTITY_PROVIDER_CLIENT_SECRET"
server_metadata_url = "https://identity-provider.invalid/.well-known/openid-configuration"
